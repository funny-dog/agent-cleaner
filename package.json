{
  "name": "agent-cleaner-workspace",
  "private": true,
  "version": "0.2.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funny-dog/agent-cleaner.git"
  },
  "workspaces": [
    "apps/*",
    "plugins/*"
  ],
  "scripts": {
    "dev:desktop": "npm --workspace=@agent-cleaner/desktop run tauri dev",
    "build:desktop": "npm --workspace=@agent-cleaner/desktop run tauri build",
    "build:plugins": "npm --workspace=dsh-agent-cleaner run build",
    "install:cli": "sh ./install.sh --local",
    "typecheck": "npm --workspace=@agent-cleaner/desktop run typecheck && npm --workspace=dsh-agent-cleaner run typecheck"
  }
}
